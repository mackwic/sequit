{
	"name": "sequit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"clean": "node scripts/clean.mjs",
		"dev": "portless run --name sequit pnpm run dev:stack",
		"dev:stack": "node scripts/dev.mjs",
		"dev:web": "vite dev",
		"dev:collaboration": "wrangler dev --config src/workers/collaboration-worker/wrangler.jsonc",
		"dev:e2e": "pnpm run dev:web --port 4174",
		"build": "pnpm run build:web && pnpm run build:collaboration",
		"build:web": "vite build",
		"build:collaboration": "wrangler deploy --dry-run --config src/workers/collaboration-worker/wrangler.jsonc --outdir .wrangler/dist/collaboration",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --config config/wrangler.jsonc --port 4173",
		"format": "prettier --config config/prettier.config.js --ignore-path config/prettier.ignore --write .",
		"format:check": "prettier --config config/prettier.config.js --ignore-path config/prettier.ignore --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"lint:staged": "lint-staged",
		"quality:fast": "pnpm run lint && pnpm run quality:unused && pnpm run quality:architecture && pnpm run test:coverage && pnpm run quality:duplicates",
		"quality:architecture": "depcruise src --config config/dependency-cruiser.cjs --output-type err",
		"quality:duplicates": "jscpd src --config config/jscpd.json",
		"quality:unused": "knip",
		"prepare": "svelte-kit sync && husky",
		"check": "pnpm run format:check && pnpm run check:types && pnpm run quality:fast && pnpm run test:e2e && pnpm run build",
		"check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project src/workers/collaboration-worker/tsconfig.json && tsc --project tests/workers/collaboration-worker/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"types:web": "wrangler types --config config/wrangler.jsonc",
		"types:collaboration": "wrangler types --config src/workers/collaboration-worker/wrangler.jsonc src/workers/collaboration-worker/worker-configuration.d.ts",
		"gen": "pnpm run types:web && pnpm run types:collaboration",
		"test": "pnpm run test:web && pnpm run test:collaboration",
		"test:coverage": "pnpm run test:coverage:web && pnpm run test:coverage:collaboration",
		"test:coverage:web": "vitest run --config config/vitest.config.ts --coverage",
		"test:coverage:collaboration": "vitest run --config src/workers/collaboration-worker/vitest.config.ts --coverage",
		"test:web": "vitest run --config config/vitest.config.ts",
		"test:collaboration": "vitest run --config src/workers/collaboration-worker/vitest.config.ts",
		"test:property": "vitest run --config config/vitest.config.ts tests/lib/core/document/validate-logic-document.property.test.ts tests/lib/core/graph/logic-graph.property.test.ts tests/lib/infrastructure/toml/document-roundtrip.property.test.ts tests/app/web/projection/layout-graph.property.test.ts tests/lib/core/layout/dedicated-layout-components.property.test.ts tests/lib/infrastructure/collaboration/yjs-live-document.property.test.ts tests/lib/infrastructure/collaboration/protocol.property.test.ts tests/lib/infrastructure/collaboration/room-persistence.property.test.ts",
		"test:property:fuzz": "SEQUIT_PROPERTY_MODE=fuzz pnpm run test:property",
		"test:mutation": "stryker run config/stryker.config.json",
		"test:mutation:weekly": "SEQUIT_PROPERTY_MODE=fuzz pnpm run test:mutation --timeoutMS 60000 --dryRunTimeoutMinutes 10",
		"test:e2e": "playwright test --config config/playwright.config.ts",
		"benchmark:layout": "vitest bench --run --config config/vitest.performance.config.ts tests/app/web/projection/performance/layout-graph.bench.ts",
		"benchmark:graph": "vitest bench --run --config config/vitest.performance.config.ts tests/lib/core/graph/performance/graph-preparation.bench.ts",
		"benchmark:authorization": "vitest bench --run --config config/vitest.performance.config.ts tests/lib/infrastructure/collaboration/performance/authorize-proposal.bench.ts",
		"benchmark:performance": "pnpm run benchmark:graph && pnpm run benchmark:layout",
		"benchmark:incremental": "vitest bench --run --config config/vitest.performance.config.ts tests/lib/core/layout/performance/incremental-layout.bench.ts",
		"test:performance": "vitest run --config config/vitest.performance.config.ts tests/app/web/projection/performance/layout-graph-performance.test.ts",
		"test:incremental-performance": "vitest run --config config/vitest.performance.config.ts tests/lib/core/layout/performance/incremental-layout-performance.test.ts"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,svelte}": [
			"prettier --config config/prettier.config.js --ignore-path config/prettier.ignore --check",
			"eslint --max-warnings 0 --no-warn-ignored"
		],
		"*.{css,html,json,jsonc,md,yaml,yml}": "prettier --config config/prettier.config.js --ignore-path config/prettier.ignore --check"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.22.0",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.63.0",
		"@stryker-mutator/core": "^10.0.0",
		"@stryker-mutator/vitest-runner": "^10.0.0",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.13.3",
		"@vitest/coverage-istanbul": "^4.1.11",
		"concurrently": "^10.0.5",
		"dependency-cruiser": "^18.2.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-svelte": "^3.23.0",
		"fast-check": "^4.9.0",
		"globals": "^17.12.0",
		"husky": "^9.1.7",
		"jscpd": "^5.1.2",
		"knip": "^6.34.0",
		"lint-staged": "^17.5.0",
		"portless": "^0.15.6",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.0",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2",
		"vitest": "^4.1.11",
		"wrangler": "^4.129.0"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@phosphor-icons/core": "^2.1.1",
		"fractional-indexing": "4.0.0",
		"lib0": "^0.2.99",
		"smol-toml": "^1.8.0",
		"yjs": "^13.6.32"
	}
}
