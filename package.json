{
	"name": "sequit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others-on-fail --names web,collaboration \"pnpm dev:web\" \"pnpm dev:collaboration\"",
		"dev:web": "vite dev",
		"dev:collaboration": "wrangler dev --config workers/collaboration/wrangler.jsonc --port 8787",
		"build": "pnpm build:web && pnpm build:collaboration",
		"build:web": "vite build",
		"build:collaboration": "wrangler deploy --dry-run --config workers/collaboration/wrangler.jsonc --outdir .wrangler/dist/collaboration",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project workers/collaboration/tsconfig.json && tsc --project workers/collaboration/test/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"types:web": "wrangler types",
		"types:collaboration": "wrangler types --config workers/collaboration/wrangler.jsonc workers/collaboration/worker-configuration.d.ts",
		"gen": "pnpm types:web && pnpm types:collaboration",
		"test": "vitest run --config workers/collaboration/vitest.config.ts"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.6",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"concurrently": "^10.0.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.0.16",
		"vitest": "^4.1.0",
		"wrangler": "^4.97.0"
	},
	"packageManager": "pnpm@8.7.6+sha1.a428b12202bc4f23b17e6dffe730734dae5728e2"
}
