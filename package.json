{
	"name": "sequit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "concurrently --kill-others-on-fail --names web,collaboration \"pnpm dev:web\" \"pnpm dev:collaboration\"",
		"dev:web": "vite dev",
		"dev:collaboration": "wrangler dev --config workers/collaboration/wrangler.jsonc --port 8787",
		"dev:e2e": "pnpm dev:web --port 4174",
		"build": "pnpm build:web && pnpm build:collaboration",
		"build:web": "vite build",
		"build:collaboration": "wrangler deploy --dry-run --config workers/collaboration/wrangler.jsonc --outdir .wrangler/dist/collaboration",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"quality": "pnpm check",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm format:check && pnpm lint && pnpm check:types && pnpm test:coverage && pnpm test:e2e && pnpm build",
		"check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project workers/collaboration/tsconfig.json && tsc --project workers/collaboration/test/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"types:web": "wrangler types",
		"types:collaboration": "wrangler types --config workers/collaboration/wrangler.jsonc workers/collaboration/worker-configuration.d.ts",
		"gen": "pnpm types:web && pnpm types:collaboration",
		"test": "pnpm test:web && pnpm test:collaboration",
		"test:coverage": "pnpm test:coverage:web && pnpm test:coverage:collaboration",
		"test:coverage:web": "vitest run --config vitest.config.ts --coverage",
		"test:coverage:collaboration": "vitest run --config workers/collaboration/vitest.config.ts --coverage",
		"test:web": "vitest run --config vitest.config.ts",
		"test:collaboration": "vitest run --config workers/collaboration/vitest.config.ts",
		"test:e2e": "playwright test"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.6",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26.1.1",
		"@vitest/coverage-istanbul": "^4.1.10",
		"concurrently": "^10.0.3",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.7.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.0",
		"wrangler": "^4.97.0"
	},
	"packageManager": "pnpm@10.34.1",
	"dependencies": {
		"smol-toml": "^1.7.0",
		"yjs": "^13.6.31"
	}
}
