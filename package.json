{
	"name": "sequit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "24.x"
	},
	"scripts": {
		"dev": "portless run --name sequit pnpm run dev:stack",
		"dev:stack": "node scripts/dev.mjs",
		"dev:web": "vite dev",
		"dev:collaboration": "wrangler dev --config workers/collaboration/wrangler.jsonc",
		"dev:e2e": "pnpm dev:web --port 4174",
		"build": "pnpm build:web && pnpm build:collaboration",
		"build:web": "vite build",
		"build:collaboration": "wrangler deploy --dry-run --config workers/collaboration/wrangler.jsonc --outdir .wrangler/dist/collaboration",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix --max-warnings 0",
		"quality": "pnpm quality:fast && pnpm test:mutation",
		"quality:fast": "pnpm lint && pnpm quality:unused && pnpm quality:architecture && pnpm test:coverage && pnpm quality:duplicates",
		"quality:architecture": "depcruise src workers/collaboration/src --output-type err",
		"quality:duplicates": "jscpd src workers/collaboration/src",
		"quality:unused": "knip",
		"prepare": "svelte-kit sync && husky",
		"check": "pnpm format:check && pnpm check:types && pnpm quality && pnpm test:e2e && pnpm build",
		"check:types": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --project workers/collaboration/tsconfig.json && tsc --project workers/collaboration/test/tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"types:web": "wrangler types",
		"types:collaboration": "wrangler types --config workers/collaboration/wrangler.jsonc workers/collaboration/worker-configuration.d.ts",
		"gen": "pnpm types:web && pnpm types:collaboration",
		"test": "pnpm test:web && pnpm test:collaboration",
		"test:coverage": "pnpm test:coverage:web && pnpm test:coverage:collaboration",
		"test:coverage:web": "vitest run --config vitest.config.ts --coverage",
		"test:coverage:collaboration": "vitest run --config workers/collaboration/vitest.config.ts --coverage",
		"test:web": "vitest run --config vitest.config.ts",
		"test:collaboration": "vitest run --config workers/collaboration/vitest.config.ts",
		"test:property": "vitest run --config vitest.config.ts tests/document/validate-logic-document.property.test.ts tests/graph/logic-graph.property.test.ts tests/text/document-roundtrip.property.test.ts tests/layout/layout-graph.property.test.ts tests/layout/dedicated-layout-components.property.test.ts tests/collaboration/yjs-live-document.property.test.ts",
		"test:property:fuzz": "SEQUIT_PROPERTY_MODE=fuzz pnpm test:property",
		"test:mutation": "stryker run",
		"test:e2e": "playwright test",
		"benchmark:layout": "vitest bench --run --config vitest.performance.config.ts tests/performance/layout-graph.bench.ts",
		"benchmark:graph": "vitest bench --run --config vitest.performance.config.ts tests/performance/graph-preparation.bench.ts",
		"benchmark:performance": "pnpm benchmark:graph && pnpm benchmark:layout",
		"benchmark:incremental": "vitest bench --run --config vitest.performance.config.ts tests/performance/incremental-layout.bench.ts",
		"test:performance": "vitest run --config vitest.performance.config.ts tests/performance/layout-graph-performance.test.ts",
		"test:incremental-performance": "vitest run --config vitest.performance.config.ts tests/performance/incremental-layout-performance.test.ts"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,svelte}": [
			"prettier --check",
			"eslint --max-warnings 0"
		],
		"*.{css,html,json,jsonc,md,yaml,yml}": "prettier --check"
	},
	"devDependencies": {
		"@cloudflare/vitest-pool-workers": "^0.18.6",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.61.1",
		"@stryker-mutator/core": "^9.6.1",
		"@stryker-mutator/vitest-runner": "^9.6.1",
		"@sveltejs/adapter-cloudflare": "^7.2.8",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-istanbul": "^4.1.10",
		"concurrently": "^10.0.3",
		"dependency-cruiser": "^18.1.1",
		"eslint": "^10.7.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-sonarjs": "^4.2.0",
		"eslint-plugin-svelte": "^3.22.0",
		"fast-check": "^4.9.0",
		"globals": "^17.7.0",
		"husky": "^9.1.7",
		"jscpd": "^5.0.14",
		"knip": "^6.31.0",
		"lint-staged": "^16.4.0",
		"portless": "^0.15.5",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.65.0",
		"vite": "^8.0.16",
		"vitest": "^4.1.0",
		"wrangler": "^4.97.0"
	},
	"packageManager": "pnpm@10.34.1",
	"dependencies": {
		"fractional-indexing": "4.0.0",
		"smol-toml": "^1.7.0",
		"yjs": "^13.6.31"
	}
}
