{
	"$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"buildCommand": "pnpm exec svelte-kit sync",
	"cleanTempDir": "always",
	"ignorePatterns": [".humanlayer"],
	"timeoutMS": 20000,
	"vitest": {
		"configFile": "vitest.config.ts",
		"related": true
	},
	"mutate": [
		"src/lib/document/collaborative-document-session.ts",
		"src/lib/document/collaborative-session-documents.ts",
		"src/lib/document/collaborative-session-proposal.ts",
		"src/lib/document/collaborative-session.ts",
		"src/lib/document/collaborative-session-sync.ts",
		"src/lib/document/pending-operations.ts",
		"src/lib/document/validate-logic-document.ts",
		"src/lib/collaboration/authorize-proposal.ts",
		"src/lib/collaboration/protocol.ts",
		"src/lib/collaboration/room-decision.ts",
		"src/lib/collaboration/room-persistence.ts",
		"src/lib/collaboration/update-guards.ts",
		"src/lib/collaboration/yjs-document-reader.ts",
		"src/lib/collaboration/yjs-document-repository.ts:57-80",
		"src/lib/collaboration/yjs-document-repository.ts:218-221",
		"src/lib/collaboration/yjs-document-repository.ts:236-239",
		"src/lib/document/document-command-gateway.ts:20-24",
		"src/lib/document/document-command-gateway.ts:126-155",
		"src/lib/document/document-command-gateway.ts:203-204",
		"src/lib/text/map-sequit-document.ts",
		"src/lib/graph/create-adjacency.ts",
		"src/lib/graph/create-graph.ts",
		"src/lib/graph/find-cycle.ts",
		"src/lib/graph/topological-ranks.ts",
		"src/lib/layout/layout-graph.ts",
		"src/lib/layout/component-layout.ts",
		"src/lib/layout/dedicated-layout-engine.ts",
		"src/lib/canvas/canvas-entity.ts",
		"src/lib/canvas/canvas-viewport.ts",
		"src/lib/session/canvas-session.svelte.ts",
		"src/lib/text/serialize-sequit-toml.ts"
	],
	"thresholds": {
		"high": 90,
		"low": 80,
		"break": 80
	},
	"reporters": ["progress", "html", "json"],
	"htmlReporter": {
		"fileName": "coverage/mutation/index.html"
	},
	"jsonReporter": {
		"fileName": "coverage/mutation/mutation.json"
	}
}
