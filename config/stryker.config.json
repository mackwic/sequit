{
	"$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
	"testRunner": "vitest",
	"plugins": ["@stryker-mutator/vitest-runner"],
	"buildCommand": "pnpm exec svelte-kit sync",
	"cleanTempDir": "always",
	"ignorePatterns": [".humanlayer"],
	"timeoutMS": 20000,
	"vitest": {
		"configFile": "config/vitest.config.ts",
		"related": true
	},
	"mutate": [
		"src/lib/infrastructure/collaboration/collaborative-document-session.ts",
		"src/lib/infrastructure/collaboration/collaborative-session.ts",
		"src/lib/core/document/validate-logic-document.ts",
		"src/lib/infrastructure/collaboration/authorize-proposal.ts",
		"src/lib/infrastructure/collaboration/protocol.ts",
		"src/lib/infrastructure/collaboration/room-persistence.ts",
		"src/lib/infrastructure/collaboration/update-guards.ts",
		"src/lib/infrastructure/collaboration/yjs-document-reader.ts",
		"src/lib/infrastructure/document/document-command-contracts.ts:14-19",
		"src/app/web/document/local-document-session.ts",
		"src/lib/infrastructure/toml/map-sequit-document.ts",
		"src/lib/core/graph/create-adjacency.ts",
		"src/lib/core/graph/create-graph.ts",
		"src/lib/core/graph/find-cycle.ts",
		"src/lib/core/graph/topological-ranks.ts",
		"src/app/web/projection/layout-graph.ts",
		"src/app/web/ui/canvas/canvas-entity.ts",
		"src/app/web/ui/canvas/canvas-viewport.ts",
		"src/app/web/ui/session/canvas-session.svelte.ts",
		"src/lib/infrastructure/toml/serialize-sequit-toml.ts",
		"src/lib/core/layout/layout-engine.ts",
		"src/lib/core/layout/layout-settings.ts",
		"src/lib/core/layout/build-layout-result.ts",
		"src/lib/core/layout/geometry/*.ts",
		"src/lib/core/layout/structure/*.ts",
		"src/lib/core/layout/placement/*.ts",
		"src/lib/infrastructure/collaboration/session-wire.ts",
		"src/lib/infrastructure/collaboration/wire-values.ts",
		"src/lib/infrastructure/collaboration/shared-command-codec.ts",
		"src/lib/infrastructure/collaboration/shared-command-executor.ts",
		"src/lib/infrastructure/collaboration/shared-element.ts",
		"src/lib/infrastructure/collaboration/shared-text.ts",
		"src/lib/infrastructure/collaboration/sync-steps.ts",
		"src/lib/infrastructure/collaboration/text-update-buffer.ts",
		"src/lib/infrastructure/collaboration/text-update-validation.ts",
		"src/lib/infrastructure/collaboration/reconcile-shared-document.ts",
		"src/lib/infrastructure/collaboration/upgrade-shared-texts.ts",
		"src/lib/infrastructure/collaboration/yjs-field-readers.ts",
		"src/lib/infrastructure/collaboration/yjs-group-state.ts",
		"src/lib/infrastructure/collaboration/yjs-document-repository.ts"
	],
	"thresholds": {
		"high": 90,
		"low": 80,
		"break": 80
	},
	"reporters": ["progress", "html", "json"],
	"htmlReporter": {
		"fileName": "coverage/mutation/index.html"
	},
	"jsonReporter": {
		"fileName": "coverage/mutation/mutation.json"
	}
}
