{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "sequit",
	"compatibility_date": "2026-07-21",
	"compatibility_flags": ["nodejs_compat"],
	"main": "../.svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": "../.svelte-kit/cloudflare",
	},
	// `/collab/<room>` upgrades are forwarded to the collaboration worker; see src/routes/collab.
	"services": [
		{
			"binding": "COLLABORATION",
			"service": "sequit-collaboration",
		},
	],
	// Anonymized layout reports, written by `POST /layout-reports`; see src/routes/layout-reports.
	"r2_buckets": [
		{
			"binding": "LAYOUT_REPORTS",
			"bucket_name": "sequit-layout-reports",
		},
	],
	"version_metadata": {
		"binding": "CF_VERSION_METADATA",
	},
	"workers_dev": true,
	"preview_urls": true,
}
