{
	"$schema": "../../../node_modules/wrangler/config-schema.json",
	"name": "sequit-collaboration",
	"main": "index.ts",
	"compatibility_date": "2026-07-21",
	// Reached only through the web worker's COLLABORATION service binding: no public URL.
	"workers_dev": false,
	"preview_urls": false,
	"durable_objects": {
		"bindings": [
			{
				"name": "COLLABORATION_ROOMS",
				"class_name": "CollaborationRoom",
			},
		],
	},
	"r2_buckets": [
		{
			"binding": "ROOM_ARCHIVE",
			"bucket_name": "sequit-room-archive",
		},
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["CollaborationRoom"],
		},
	],
	"observability": {
		"enabled": true,
	},
}
